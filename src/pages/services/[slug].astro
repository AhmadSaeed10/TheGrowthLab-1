---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Img from '../../components/Img.astro';
import WorkCard from '../../components/WorkCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { model } from '../../data/model';

export async function getStaticPaths() {
  const all = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, others: all.filter((x) => x.id !== entry.id), related: work.filter((w) => w.data.disciplines.includes(entry.data.discipline)).slice(0, 3) },
  }));
}
const { entry, others, related } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const base = Astro.site!;
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: d.title, description: d.seoDescription, serviceType: d.title, provider: { '@id': new URL('/#agency', base).href }, url: new URL(`/services/${entry.id}/`, base).href },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: base.href },
    { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services/', base).href },
    { '@type': 'ListItem', position: 3, name: d.title },
  ] },
];
---
<Base title={d.seoTitle} description={d.seoDescription} schema={schema}>
  <PageHero title={d.title} lead={d.summary} crumbs={[{ label: 'Services', href: '/services/' }, { label: d.title }]}>
    <p class="t-h3 tag" data-reveal="fade" data-delay="0.5s"><span class="hl hl--label">{d.tagline}</span></p>
    <div class="cta-row" data-reveal="fade" data-delay="0.6s">
      <a class="btn" href={`/contact/?need=${entry.id}`} data-magnetic>Start your brief<span class="btn__ico"></span></a>
      <a class="btn btn--ghost" href="/work/">See our work</a>
    </div>
  </PageHero>

  <section class="sec body">
    <div class="wrap body__grid">
      <div class="body__img" data-reveal="img">
        <Img src={d.cover} alt={d.coverAlt} sizes="(min-width: 900px) 46vw, 92vw" style={`object-position:${d.focal}`} loading="eager" />
        {d.keyFact && (
          <div class="fact">
            <p class="fact__n t-big">{d.keyFact.value}</p>
            <p class="fact__l">{d.keyFact.label}</p>
          </div>
        )}
      </div>
      <div class="body__txt">
        <h2 class="t-h3">What's included</h2>
        <div class="chips" data-reveal="stagger">{d.chips.map((c) => <span class="chip">{c}</span>)}</div>
        <div class="prose"><Content /></div>
      </div>
    </div>
  </section>

  <section class="sec sec--fog get" aria-labelledby="get-title">
    <div class="wrap get__grid">
      <h2 id="get-title" class="t-h2" data-reveal="words">What you <span class="hl">get</span></h2>
      <ul class="get__list" data-reveal="stagger">
        {d.outcomes.map((o) => <li><span class="get__ptr" aria-hidden="true"></span>{o}</li>)}
      </ul>
    </div>
  </section>

  <section class="sec fit" aria-labelledby="fit-title">
    <div class="wrap">
      <h2 id="fit-title" class="t-h3 fit__t">Where this sits in the <a class="textlink" href="/model/">TGL model</a></h2>
      <ol class="fit__row" data-reveal="stagger">
        {model.map((m) => (
          <li class:list={[{ 'is-on': m.step === d.step }]}><span class="t-big">{m.step}</span><span class="fit__l">{m.line}</span></li>
        ))}
      </ol>
    </div>
  </section>

  {related.length > 0 && (
    <section class="sec rel" aria-labelledby="rel-title">
      <div class="wrap">
        <h2 id="rel-title" class="t-h2" data-reveal="words">Related <span class="hl">work</span></h2>
        <div class="rel__grid">
          {related.map((w) => <WorkCard work={w} size="portrait" sizes="(min-width: 900px) 30vw, 90vw" />)}
        </div>
      </div>
    </section>
  )}

  <section class="sec oth" aria-labelledby="oth-title">
    <div class="wrap">
      <h2 id="oth-title" class="t-h3">More from the team</h2>
      <div class="chips oth__c">{others.map((o) => <a class="chip" href={`/services/${o.id}/`}>{o.data.title}</a>)}</div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .tag { font-size: clamp(1rem, 2vw, 1.5rem); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .body__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .body__img { position: relative; background: var(--fog); aspect-ratio: 4 / 5; overflow: hidden; }
  .body__img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .fact { position: absolute; left: 0; bottom: 0; background: var(--red); color: var(--ink); padding: 1rem 1.25rem; max-width: 80%; }
  .fact__n { font-size: clamp(2.8rem, 6vw, 4.6rem); }
  .fact__l { font-weight: 700; font-size: 0.85rem; line-height: 1.3; }
  .body__txt { display: grid; gap: 1.5rem; }
  .prose { display: grid; gap: 1.1rem; max-width: 58ch; }
  .get__grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(2rem, 5vw, 5rem); }
  .get__list { display: grid; gap: 0; border-top: 2px solid var(--ink); }
  .get__list li { display: flex; gap: 1rem; align-items: flex-start; padding-block: 1.1rem; border-bottom: 1px solid #d9dde3; font-weight: 700; font-size: clamp(1.05rem, 1.7vw, 1.35rem); line-height: 1.3; }
  .get__ptr { flex: none; width: 14px; height: 22px; margin-top: 0.15em; background: url('/cursor.svg') no-repeat center / contain; }
  .fit__t { margin-bottom: 1.5rem; }
  .fit__row { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); border-top: 2px solid var(--ink); }
  .fit__row li { display: grid; gap: 0.3rem; padding: 1rem 0.8rem 1.2rem 0; color: #b4b8be; transition: color 0.3s; }
  .fit__row li + li { padding-left: 0.8rem; border-left: 1px solid var(--label); }
  .fit__row li.is-on { color: var(--ink); background: linear-gradient(var(--red), var(--red)) no-repeat 0 0 / 100% 6px; }
  .fit__row .t-big { font-size: clamp(1.8rem, 3.6vw, 3.2rem); }
  .fit__l { font-size: 0.82rem; font-weight: 600; }
  .rel__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 2.5rem; }
  .oth__c { margin-top: 1rem; }
  @media (max-width: 900px) {
    .body__grid, .get__grid { grid-template-columns: 1fr; }
    .fit__row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fit__row li:nth-child(odd) { padding-left: 0; border-left: 0; }
    .rel__grid { grid-template-columns: 1fr; }
  }
</style>
