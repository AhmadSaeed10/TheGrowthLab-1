---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Stats from '../components/Stats.astro';
import ServiceList from '../components/ServiceList.astro';
import WorkReel from '../components/WorkReel.astro';
import ModelScroller from '../components/ModelScroller.astro';
import Think from '../components/Think.astro';
import Performance from '../components/Performance.astro';
import Team from '../components/Team.astro';
import AiBand from '../components/AiBand.astro';
import Juggle from '../components/Juggle.astro';
import Faq from '../components/Faq.astro';
