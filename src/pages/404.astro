---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Page not found | The Growth Lab" description="This page does not exist." noindex hideMobileCta>
  <PageHero title="Page not" hl="found." lead="The page you wanted has moved or never existed. Try one of these.">
    <div style="display:flex;flex-wrap:wrap;gap:.75rem">
      <a class="btn" href="/">Back home<span class="btn__ico"></span></a>
      <a class="btn btn--ghost" href="/work/">See our work</a>
      <a class="btn btn--ghost" href="/contact/">Contact us</a>
    </div>
  </PageHero>
</Base>
