---
import { getCollection } from 'astro:content';
import { site } from '../site';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const stages = ['Launching a new brand', 'Growing an existing store', 'Fixing something that is not working'];
const budgets = ['Not sure yet', 'Under 1k USD', '1k to 5k USD', '5k to 20k USD', '20k+ USD'];
---
<form class="brief" data-brief data-wa={site.whatsapp} data-email={site.email} data-endpoint={site.formEndpoint} novalidate>
  <input class="brief__hp" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="brief__head" data-brief-head>
    <p class="brief__count" data-brief-count>Step 1 of 3</p>
    <div class="brief__bar" aria-hidden="true"><i data-brief-bar></i></div>
  </div>

  <div data-brief-step>
    <fieldset>
      <legend tabindex="-1">What do you need help with?</legend>
      <p class="brief__hint">Pick all that apply.</p>
      <div class="picks">
        {services.map((s) => (
          <label class="pick"><input type="checkbox" name="need" value={s.data.title} data-slug={s.id} /><span>{s.data.title}</span></label>
        ))}
        <label class="pick"><input type="checkbox" name="need" value="Not sure yet" data-slug="not-sure" /><span>Not sure yet</span></label>
      </div>
    </fieldset>
  </div>

  <div data-brief-step hidden>
    <fieldset>
      <legend tabindex="-1">Where are you right now?</legend>
      <div class="picks">
        {stages.map((s) => <label class="pick"><input type="radio" name="stage" value={s} /><span>{s}</span></label>)}
      </div>
    </fieldset>
    <fieldset>
      <legend>Monthly ad budget</legend>
      <div class="picks">
        {budgets.map((b) => <label class="pick"><input type="radio" name="budget" value={b} /><span>{b}</span></label>)}
      </div>
    </fieldset>
  </div>

  <div data-brief-step hidden>
    <h3 class="brief__h" tabindex="-1">Who should we reply to?</h3>
    <div class="fields">
      <div class="field"><label for={`n-${Astro.url.pathname}`}>Your name</label><input id={`n-${Astro.url.pathname}`} name="name" autocomplete="name" /></div>
      <div class="field"><label for={`c-${Astro.url.pathname}`}>Email or WhatsApp number</label><input id={`c-${Astro.url.pathname}`} name="contact" autocomplete="email" /></div>
      <div class="field"><label for={`b-${Astro.url.pathname}`}>Brand name or website</label><input id={`b-${Astro.url.pathname}`} name="brand" autocomplete="url" /></div>
      <div class="field"><label for={`t-${Astro.url.pathname}`}>Anything else we should know?</label><textarea id={`t-${Astro.url.pathname}`} name="notes" rows="3"></textarea></div>
    </div>
  </div>

  <p class="brief__err" data-brief-err role="alert"></p>

  <div class="brief__nav" data-brief-nav>
    <button type="button" class="btn btn--ghost" data-back hidden>Back</button>
    <button type="button" class="btn" data-next>Next<span class="btn__ico"></span></button>
    <button type="submit" class="btn" data-send hidden>Send my brief<span class="btn__ico"></span></button>
  </div>

  <div class="brief__done" data-brief-sent hidden>
    <h3 class="brief__h" tabindex="-1">Brief received.</h3>
    <p>Thanks<span data-sent-name></span>. Your brief is with the team and we will get back to you shortly.</p>
  </div>

  <div class="brief__done" data-brief-done hidden>
    <h3 class="brief__h" tabindex="-1">Your brief is ready.</h3>
    <p>We are opening <b data-channel>your email app</b> with your brief filled in. Press send there and it reaches us. If nothing opened, copy it below and send it yourself.</p>
    <textarea data-brief-body readonly rows="8" aria-label="Your brief"></textarea>
    <button type="button" class="btn btn--ghost" data-copy>Copy brief</button>
  </div>
</form>

<style>
  .brief { background: #fff; color: var(--ink); border: 2px solid var(--ink); box-shadow: 12px 12px 0 var(--ink); padding: clamp(1.25rem, 3vw, 2.25rem); display: grid; gap: 1.25rem; }
  .brief__head { display: grid; gap: 0.6rem; }
  .brief__count { font-weight: 800; font-size: 0.9rem; }
  .brief__bar { height: 6px; background: var(--label); }
  .brief__bar i { display: block; height: 100%; width: calc(var(--p, 0.33) * 100%); background: var(--red); transition: width 0.5s var(--ease); }
  fieldset { border: 0; padding: 0; margin: 0 0 1.25rem; min-width: 0; }
  legend, .brief__h { font-weight: 900; text-transform: uppercase; font-size: clamp(1.3rem, 2.4vw, 1.8rem); line-height: 1.05; letter-spacing: -0.025em; padding: 0; margin-bottom: 0.6rem; }
  legend:focus, .brief__h:focus { outline: none; }
  .brief__hint { color: var(--ink-2); font-size: 0.9rem; margin-bottom: 0.9rem; }
  .picks { display: flex; flex-wrap: wrap; gap: 8px; }
  .pick { position: relative; }
  .pick input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .pick span { display: inline-block; padding: 0.7rem 1rem; background: var(--label); font-weight: 700; font-size: 0.92rem; line-height: 1.2; border: 2px solid transparent; transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s var(--ease); }
  .pick:hover span { border-color: var(--ink); }
  .pick input:checked + span { background: var(--red); color: #fff; }
  .pick input:active + span { transform: scale(0.96); }
  .pick input:focus-visible + span { outline: 3px solid var(--ink); outline-offset: 2px; }
  .fields { display: grid; gap: 1rem; }
  .field { display: grid; gap: 0.35rem; }
  .field label { font-weight: 700; font-size: 0.9rem; }
  .field input, .field textarea, .brief__done textarea { font: inherit; padding: 0.8rem 0.9rem; min-height: 52px; border: 2px solid var(--ink); background: #fff; color: var(--ink); width: 100%; border-radius: 0; }
  .field input:focus, .field textarea:focus { outline: 3px solid rgba(211, 21, 27, 0.35); border-color: var(--red); }
  .brief__err { color: var(--red-deep); font-weight: 700; font-size: 0.92rem; min-height: 1.4em; }
  .brief__nav { display: flex; gap: 8px; flex-wrap: wrap; }
  .brief__nav .btn { flex: 1 1 auto; }
  .brief__hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .brief__done { display: grid; gap: 1rem; justify-items: start; }
  .brief__done textarea { font-size: 0.9rem; min-height: 170px; }
  @media (max-width: 520px) { .brief { box-shadow: 6px 6px 0 var(--ink); } }
</style>
