---
import Img from './Img.astro';
import brain from '../assets/brand/brain.png';
import { think } from '../data/model';
---
<section class="sec think" aria-labelledby="think-title">
  <div class="wrap think__grid">
    <div class="think__copy">
      <h2 id="think-title" class="t-h1" data-reveal="words">How we <span class="hl">think</span></h2>
      <p class="think__lead" data-reveal="fade">We combine</p>
      <ol class="think__flow" data-reveal="stagger" aria-label="Insight, strategy, idea, execution, distribution, data">
        {think.map((t) => <li><span class="think__w">{t}</span><svg class="think__tri" viewBox="0 0 10 16" aria-hidden="true"><path d="M1 1 9 8 1 15Z" /></svg></li>)}
      </ol>
      <p class="think__why" data-reveal="fade">So every piece of work has a reason to exist, and a result it needs to deliver.</p>
      <p class="t-h3 think__line" data-reveal="fade">Less guesswork.<br /><span class="hl hl--white">More growth</span></p>
    </div>
    <div class="think__art" data-tilt="7">
      <div class="think__tilt">
        <Img src={brain} alt="A halftone illustration of a brain" sizes="(min-width: 900px) 40vw, 80vw" widths={[500, 800, 1100]} />
        <svg class="bolts" viewBox="0 0 200 200" aria-hidden="true">
          <path class="b1" d="M118 52 96 92h20l-14 38 38-52h-24l16-26z" />
          <path class="b2" d="M62 98 40 128h16l-8 26 28-36H62l10-20z" />
          <path class="b3" d="M150 112l-14 22h10l-6 20 20-26h-11l8-16z" />
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .think__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .think__copy { display: grid; gap: 1.25rem; justify-items: start; }
  .think__lead { font-size: clamp(1.2rem, 2.4vw, 2rem); font-weight: 300; }
  .think__flow { display: flex; flex-wrap: wrap; gap: 0.35rem 0.6rem; align-items: center; font-weight: 800; text-transform: uppercase; font-size: clamp(1.2rem, 2.8vw, 2.2rem); letter-spacing: -0.02em; line-height: 1.15; }
  .think__flow li { display: inline-flex; align-items: center; gap: 0.6rem; }
  .think__w { transition: background-size 0.4s var(--ease-io), color 0.3s; background: linear-gradient(var(--red), var(--red)) no-repeat 0 100% / 100% 0.1em; padding: 0 0.04em; cursor: default; }
  .think__w:hover { background-size: 100% 100%; }
  .think__tri { width: 0.5em; height: 0.8em; fill: none; stroke: var(--ink); stroke-width: 1.6; }
  .think__flow li:last-child .think__tri { display: none; }
  .think__why { max-width: 34ch; font-weight: 400; color: var(--ink-2); }
  .think__line { font-size: clamp(1.5rem, 3.2vw, 2.6rem); }
  .think__art { justify-self: center; width: min(100%, 520px); perspective: 1000px; }
  .think__tilt { position: relative; transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transition: transform 0.25s var(--ease); transform-style: preserve-3d; }
  .think__tilt :global(img) { width: 100%; height: auto; }
  .bolts { position: absolute; left: 22%; top: 30%; width: 62%; fill: var(--red); pointer-events: none; }
  @media (prefers-reduced-motion: no-preference) {
    .bolts path { animation: zap 2.6s steps(1) infinite; opacity: 0; }
    .bolts .b2 { animation-delay: 0.5s; }
    .bolts .b3 { animation-delay: 1.1s; }
  }
  @keyframes zap { 0%, 8% { opacity: 1; } 12%, 60% { opacity: 0; } 64%, 70% { opacity: 1; } 74%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .bolts path { opacity: 1; } }
  @media (max-width: 900px) { .think__grid { grid-template-columns: 1fr; } .think__art { width: min(100%, 360px); justify-self: start; } }
</style>
