---
---
<dialog id="lightbox" class="lb" aria-label="Image viewer">
  <div class="lb__bar">
    <span data-lb-count aria-live="polite"></span>
    <button type="button" data-lb-close>Close</button>
  </div>
  <div class="lb__stage">
    <button type="button" class="lb__nav" data-lb-prev aria-label="Previous image">Prev</button>
    <img src="" alt="" />
    <button type="button" class="lb__nav" data-lb-next aria-label="Next image">Next</button>
  </div>
  <p class="lb__cap" data-lb-cap></p>
</dialog>

<style>
  .lb { width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; padding: 1rem var(--gutter); border: 0; background: rgba(20, 20, 20, 0.96); color: #fff; }
  .lb[open] { display: grid; grid-template-rows: auto 1fr auto; gap: 1rem; animation: lb-in 0.35s var(--ease); }
  .lb::backdrop { background: rgba(0, 0, 0, 0.6); }
  @keyframes lb-in { from { opacity: 0; transform: scale(0.98); } }
  .lb__bar { display: flex; justify-content: space-between; align-items: center; font-weight: 700; }
  .lb__bar button, .lb__nav { min-height: 46px; padding: 0 1.1rem; border: 2px solid #fff; background: transparent; color: #fff; font-weight: 800; cursor: pointer; transition: background 0.2s, color 0.2s; }
  .lb__bar button:hover, .lb__nav:hover { background: #fff; color: var(--ink); }
  .lb__stage { display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: center; min-height: 0; }
  .lb__stage img { max-width: 100%; max-height: 100%; width: auto; height: auto; margin: auto; object-fit: contain; min-height: 0; }
  .lb__stage { max-height: 100%; }
  .lb__cap { max-width: 70ch; font-size: 0.92rem; color: rgba(255, 255, 255, 0.8); }
  @media (max-width: 720px) { .lb__stage { grid-template-columns: 1fr; } .lb__nav { display: none; } }
</style>
