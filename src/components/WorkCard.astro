---
import Img from './Img.astro';
interface Props { work: any; size?: 'portrait' | 'wide'; sizes?: string; eager?: boolean }
const { work, size = 'portrait', sizes = '(min-width: 1024px) 34vw, 78vw', eager = false } = Astro.props;
const d = work.data;
---
<a class:list={['wc', `wc--${size}`]} href={`/work/${work.id}/`} data-cursor="View">
  <div class="wc__img" data-reveal="img">
    <Img src={d.cover} alt={d.coverAlt} sizes={sizes} style={`object-position:${d.focal}`} loading={eager ? 'eager' : 'lazy'} />
  </div>
  <div class="wc__meta">
    <h3 class="t-h3 wc__name"><span class="wc__hl">{d.brand}</span></h3>
    <p class="wc__sector">{d.sector}</p>
    <div class="chips">{d.disciplines.map((x: string) => <span class="chip">{x}</span>)}</div>
  </div>
</a>

<style>
  .wc { display: grid; gap: 1rem; text-decoration: none; }
  .wc__img { overflow: hidden; background: var(--fog); }
  .wc--portrait .wc__img { aspect-ratio: 4 / 5; }
  .wc--wide .wc__img { aspect-ratio: 4 / 3; }
  .wc__img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (prefers-reduced-motion: no-preference) {
    .wc__img :global(img) { transition: transform 1s var(--ease); }
    .wc:hover .wc__img :global(img) { transform: scale(1.06); }
  }
  .wc__meta { display: grid; gap: 0.5rem; justify-items: start; }
  .wc__hl { background: linear-gradient(var(--red), var(--red)) no-repeat 0 0 / 0% 100%; transition: background-size 0.5s var(--ease-io); box-decoration-break: clone; -webkit-box-decoration-break: clone; padding: 0.02em 0.1em; margin-left: -0.1em; }
  .wc:hover .wc__hl, .wc:focus-visible .wc__hl { background-size: 100% 100%; }
  .wc__sector { color: var(--ink-2); font-weight: 500; font-size: 0.95rem; }
</style>
