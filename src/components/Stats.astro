---
---
<section class="stats sec" aria-label="The Growth Lab in numbers">
  <div class="wrap stats__grid" data-reveal="stagger">
    <div class="stat stat--big">
      <p class="stat__n t-big"><span data-count="4.5" data-decimals="1" data-prefix="USD " data-suffix="M">USD 4.5M</span></p>
      <p class="stat__l">in media spend managed across all platforms</p>
    </div>
    <div class="stat">
      <p class="stat__n t-big"><span data-count="13">13</span></p>
      <p class="stat__l">brands we've grown with</p>
    </div>
    <div class="stat">
      <p class="stat__n t-big"><span data-count="7">7</span></p>
      <p class="stat__l">people in one full-stack team</p>
    </div>
    <div class="stat">
      <p class="stat__n t-big"><span data-count="6">6</span></p>
      <p class="stat__l">steps in the TGL model</p>
    </div>
  </div>
</section>

<style>
  .stats { padding-block: clamp(2.5rem, 5vw, 4rem); }
  .stats__grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 0; }
  .stat { padding: 0 clamp(1rem, 2.5vw, 2.5rem); border-left: 2px solid var(--ink); }
  .stat:first-child { padding-left: 0; border-left: 0; }
  .stat__n { font-size: clamp(3.4rem, 8vw, 7.5rem); color: var(--ink); }
  .stat--big .stat__n { color: var(--red); }
  .stat__l { max-width: 22ch; font-weight: 500; font-size: 0.95rem; color: var(--ink-2); margin-top: 0.4rem; }
  @media (max-width: 820px) {
    .stats__grid { grid-template-columns: 1fr 1fr; row-gap: 2rem; }
    .stat--big { grid-column: 1 / -1; }
    .stat:nth-child(2) { padding-left: 0; border-left: 0; }
    .stat:nth-child(3), .stat:nth-child(4) { }
  }
</style>
