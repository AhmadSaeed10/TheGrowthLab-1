---
import { nav, site } from '../site';
const path = Astro.url.pathname;
const cur = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="site-header__bar wrap">
    <a href="/" class="logo" aria-label={`${site.name} home`}>
      <span class="logo__the">The</span><span class="logo__g">Growth</span><span class="logo__lab">Lab</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      {nav.map((n) => <a href={n.href} aria-current={cur(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <a class="btn site-header__cta" href="/contact/" data-magnetic>Start your brief<span class="btn__ico"></span></a>
    <button class="burger" type="button" data-menu-btn aria-expanded="false" aria-controls="menu" aria-label="Menu"><i></i><i></i></button>
  </div>
  <div class="progress" aria-hidden="true"><i></i></div>
</header>

<div id="menu" class="menu dark" data-menu inert>
  <nav class="menu__nav" aria-label="Mobile">
    {nav.map((n, i) => <a href={n.href} style={`--i:${i}`}>{n.label}</a>)}
    <a href="/contact/" style={`--i:${nav.length}`} class="menu__cta">Start your brief</a>
  </nav>
  <p class="menu__foot muted">{site.tagline}</p>
</div>

<style>
  .site-header { position: fixed; inset: 0 0 auto 0; z-index: 100; transition: transform 0.45s var(--ease); }
  .site-header::before { content: ''; position: absolute; inset: 0; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(12px); opacity: 0; transition: opacity 0.3s; z-index: -1; }
  .site-header.is-scrolled::before { opacity: 1; }
  .site-header.is-hidden { transform: translateY(-101%); }
  .site-header__bar { display: flex; align-items: center; gap: 2rem; height: var(--header-h); }
  .logo { font-family: var(--f-display); font-size: 1.85rem; line-height: 1; text-transform: uppercase; text-decoration: none; display: inline-flex; align-items: baseline; gap: 0.28em; letter-spacing: 0.01em; margin-right: auto; }
  .logo__the { font-size: 0.6em; }
  .logo__g { background: var(--red); padding: 0.06em 0.16em 0.02em; transition: background 0.25s, color 0.25s; }
  .logo:hover .logo__g { background: var(--ink); color: #fff; }
  .site-nav { display: flex; gap: clamp(1rem, 2.4vw, 2.2rem); }
  .site-nav a { font-weight: 700; font-size: 0.92rem; text-decoration: none; padding: 0.5rem 0; background: linear-gradient(var(--red), var(--red)) no-repeat 0 100% / 0% 3px; transition: background-size 0.3s var(--ease); }
  .site-nav a:hover, .site-nav a[aria-current='page'] { background-size: 100% 3px; }
  .site-header__cta { min-height: 46px; padding: 0 1.2rem; font-size: 0.9rem; }
  .progress { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; }
  .progress i { display: block; height: 100%; background: var(--red); transform-origin: 0 50%; transform: scaleX(var(--progress, 0)); }

  .burger { display: none; width: 46px; height: 46px; border: 2px solid var(--ink); background: #fff; cursor: pointer; position: relative; padding: 0; }
  .burger i { position: absolute; left: 11px; right: 11px; height: 3px; background: var(--ink); transition: transform 0.3s var(--ease), top 0.3s var(--ease); }
  .burger i:first-child { top: 15px; }
  .burger i:last-child { top: 24px; }
  :global(.menu-open) .burger i:first-child { top: 19px; transform: rotate(45deg); }
  :global(.menu-open) .burger i:last-child { top: 19px; transform: rotate(-45deg); }

  .menu { position: fixed; inset: 0; z-index: 90; padding: calc(var(--header-h) + 24px) var(--gutter) 32px; display: flex; flex-direction: column; justify-content: space-between; clip-path: inset(0 0 100% 0); visibility: hidden; transition: clip-path 0.6s var(--ease-io), visibility 0s 0.6s; }
  :global(.menu-open) .menu { clip-path: inset(0); visibility: visible; transition: clip-path 0.6s var(--ease-io), visibility 0s; }
  .menu__nav { display: flex; flex-direction: column; gap: 0.2rem; }
  .menu__nav a { font-family: var(--f-display); font-size: clamp(3.4rem, 15vw, 6rem); line-height: 1; text-transform: uppercase; text-decoration: none; opacity: 0; transform: translateY(30px); transition: opacity 0.4s, transform 0.6s var(--ease); }
  :global(.menu-open) .menu__nav a { opacity: 1; transform: none; transition-delay: calc(0.15s + var(--i) * 60ms); }
  .menu__cta { color: var(--red); }

  @media (max-width: 960px) {
    .site-nav, .site-header__cta { display: none; }
    .burger { display: block; }
    .site-header__bar { gap: 1rem; }
  }
  :global(.menu-open) .site-header::before { opacity: 0; }
  :global(.menu-open) .logo { color: #fff; }
</style>
